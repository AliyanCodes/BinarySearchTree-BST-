#include<iostream>
using namespace std;



// Task 1
template<class T>
class BNode {
public:
	T data;
	BNode* left, * right;
	BNode(T d)
	{
		data = d;
		left = right = nullptr;
	}
};
//Task 2
template<class T>
class BST {
	BNode<T>* root;
public:
	BST()
	{
		root = nullptr;
	}

	void insert(T value)//Task 3
	{
		BNode<T>* temp = new BNode<T>(value);
		if (root == NULL)
		{
			root = temp;
		}
		else
		{
			BNode<T>* curr = root;
			BNode<T>* Pcurr = NULL;
			while (curr != NULL)
			{
				Pcurr = curr;
				if (value > curr->data)
				{
					curr = curr->right;
				}
				else
				{
					curr = curr->left;
				}
			}
			if (value < Pcurr->data)
			{
				Pcurr->left = temp;
			}
			else
			{
				Pcurr->right = temp;
			}
		}
	}
	void display(BNode<T>* root)
	{
		if (root == NULL)
		{
			return;
		}
		display(root->left);
		cout << root->data << " ";
		display(root->right);
	}
	BNode<T>* getRoot()
	{
		return root;
	}
	void inorder(BNode<T>* curr)
	{
		if (curr == NULL)
		{
			return;
		}
		inorder(curr->left);
		cout << curr->data << " ";
		inorder(curr->right);
	}

	void preorder(BNode<T>* curr)
	{
		if (curr == NULL)
		{
			return;
		}
		cout << curr->data << " ";
		preorder(curr->left);
		preorder(curr->right);
	}
	void postorder(BNode<T>* curr)
	{
		if (curr == NULL)
		{
			return;
		}

		postorder(curr->left);
		postorder(curr->right);
		cout << curr->data << " ";
	}
	
	

	bool search(BNode<T>* curr, T val)
	{
		if (curr == NULL)
		{
			return false;
		}

		if (curr->data == val)
		{
			return true;
		}

		if (val < curr->data)
		{
			return search(curr->left, val);
		}
		else
		{
			return search(curr->right, val);
		}
	}
	int count(BNode<T>* curr)
	{
		// Base case: empty tree
		if (curr==NULL)
		{
			return 0;
		}
		return 1 + count(curr->left) + count(curr->right);
	}
	int count_leaves(BNode<T>* curr)
	{
		if (curr == NULL)
		{
			return 0;
		}
		if (curr->right==NULL&&curr->left==NULL)
		{
			return 1;
		}
		return  count_leaves(curr->left) + count_leaves(curr->right);
	}
	int height(BNode<T>* curr)
	{
		// Height of NULL tree = -1 (or 0 depending on definition)
		if (curr==NULL)
		{
			return -1;
		}
		else if (curr->right == NULL && curr->left == NULL)
		{
			return 0;
		}
		else
		{
			int leftHeight = height(curr->left);
			int rightHeight = height(curr->right);
			if (leftHeight> rightHeight)
			{
				return leftHeight + 1;
			}
			else
			{
				return rightHeight + 1;
			}
		}
		
		
	}
	T find_min(BNode<T>* curr)
	{
		// Keep going LEFT until no left child
		if (curr==nullptr)
		{
			return NULL;
		}
		while (curr->left!=NULL)
		{
			curr = curr->left;
		}
		return curr->data;
		// That node holds the minimum
	}
	T find_max(BNode<T>* curr)
	{
		if (curr == nullptr)
		{
			return NULL;
		}
		while (curr->right != NULL)
		{
			curr = curr->right;
		}
		return curr->data;
	}
	void mirror(BNode<T>* curr)
	{
		// Base case: NULL node, return
		if (curr == nullptr)
		{
			return;
		}
		else
		{
			BNode<T>* temp;
			temp = curr->left;
			curr->left = curr->right;
			curr->right = temp;
			mirror(curr->left);
			mirror(curr->right);
		}
		
	}
	bool is_valid_BST(BNode<T>* curr, T min_val, T max_val)
	{
		// curr's data must be strictly > min_val AND < max_val
		if (curr == nullptr)
		{
			return 1;
		}
		else
		{
			if (curr->data>min_val||curr->data<max_val)
			{
				return 0;
			}
			return is_valid_BST(curr->left, min_val, curr->data) && is_valid_BST(curr->right, curr->data, max_val);
		}
		// Recurse left with updated max, right with updated min
	}
	BNode<T>* LCA(BNode<T>* curr, T val1, T val2)
	{
		if (curr == NULL)
			return NULL;
		// Both values smaller than curr -> LCA is in left subtree
		if (val1 < curr->data && val2 < curr->data)
			return LCA(curr->left, val1, val2);
		// Both values larger than curr -> LCA is in right subtree
		if (val1 > curr->data && val2 > curr->data)
			return LCA(curr->right, val1, val2);
		// Values split here, or one equals curr -> curr IS the LCA
		return curr;
	}
};

int main() 
{
	BST<int> B;
	
	B.insert( 10);
	B.insert( 5);
	B.insert( 20);
	B.insert( 3);
	B.insert( 7);
	B.insert(15);
	B.insert(25);
	
	BNode<int>* temp1 = B.getRoot();
	cout << "Number of values in bst is:" << B.count(temp1) << endl;
	cout << "Number of leaf nodes in bst is:" << B.count_leaves(B.getRoot()) << endl;
	cout << "Height of a Tree is:" << B.height(temp1);
	cout << "\nMinimum in BST is:" << B.find_min(temp1) << endl;
	cout << "Maximum in BST is:" << B.find_max(temp1) << endl;
	cout << "Inorder before mirror:";
	B.inorder(temp1);
	B.mirror(temp1);
	cout << "\nInorder after mirror:";
	B.inorder(temp1);
	if (B.is_valid_BST(temp1, B.find_min(temp1), B.find_max(temp1)))
	{
		cout << "\nBst is valid!..."<<endl;
	}
	else
	{
		cout << "Not a valid bst!.." << endl;
	}
	BNode<int>* ans;

	ans = B.LCA(temp1, 15, 25);

	if (ans != NULL)
		cout << "LCA = " << ans->data << endl;
	else
		cout << "LCA not found" << endl;
    return 0;
}
