	void IterativePostorder(BNode<T>* curr)
	{
		if (curr==NULL)
		{
			return;
		}
		else
		{
			Stack<BNode<T>*> s1(100);
			Stack<BNode<T>*> s2(100);
			s1.push(curr);
			while (!s1.isEmpty())
			{
				curr = s1.pop();
				s2.push(curr);
				if (curr->left != NULL)
				{
					s1.push(curr->left);
				}

				if (curr->right != NULL)
				{
					s1.push(curr->right);
				}
			}
			while (!s2.isEmpty())
			{
				curr = s2.pop();
				cout << curr->data << " ";
			}
		}
	}
