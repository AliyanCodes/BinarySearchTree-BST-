#include<iostream>
using namespace std;
// Task 1
template<class T>
class BNode {
public:
	T data;
	BNode* left, * right;
	BNode(T d)
	{
		data = d;
		left = right = nullptr;
	}
};
//Task 2
template<class T>
class BST {
	BNode<T>* root;
public:
	BST()
	{
		root = nullptr;
	}
	void insert(T value)//Task 3
	{
		BNode<T>* temp = new BNode<T>(value);
		if (root==NULL)
		{
			root = temp;
		}
		else
		{
			BNode<T>* curr = root;
			BNode<T>* Pcurr = NULL;
			while(curr!=NULL)
			{
				Pcurr = curr;
				if (value>curr->data)
				{
					curr = curr->right;
				}
				else
				{
					curr = curr->left;
				}
			}
			if (value<Pcurr->data)
			{
				Pcurr->left = temp;
			}
			else
			{
				Pcurr->right = temp;
			}
		}
	}
	void Rinsert(BNode<T>* root,T value)
	{ 
	

		BNode<T>* temp = new BNode<T>(value);
		if (root == NULL)
		{
			root = temp;
		}
		else
		{
			if (value<root->data)
			{
				if (root->left==NULL)
				{
					root->left == temp;
				}
				else
				{
					Rinsert(root->left, value);
				}
				
				
			}
			else
			{
				if (root->right == NULL)
				{
					root->right == temp;
				}
				else
				{
					Rinsert(root->right, value);
				}

				
			}
		}
	}
	void display(BNode<T>* root)
	{
		if (root==NULL)
		{
			return;
		}
		display(root->left);
		cout << root->data << " ";
		display(root->right);
	}
	BNode<T>* getRoot()
	{
		return root;
	}
};
int main()
{
	BST<int> B1,B2;
	B1.insert(1);
	B1.insert(10);
	B1.insert(-11); 
	B1.insert(-45); 
	B1.insert(110);
	B1.insert(71);
	//B1.display(B1.getRoot());
	BNode<int>* temp = B2.getRoot();
	B2.Rinsert(temp, 1);
	B2.Rinsert(temp, 10);
	B2.Rinsert(temp, -11);
	B2.Rinsert(temp, -45);
	B2.Rinsert(temp, 110);
	B2.Rinsert(temp, 71);
	B2.display(B2.getRoot());
	return 0;
}
